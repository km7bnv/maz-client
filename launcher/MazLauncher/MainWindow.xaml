<Window x:Class="MazLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MazLauncher" Height="650" Width="920" MinHeight="590" MinWidth="820"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Icon="Assets/MazLauncher.ico" Background="#0B1020">
    <Window.Resources>
        <SolidColorBrush x:Key="Surface" Color="#111827"/>
        <SolidColorBrush x:Key="Surface2" Color="#182235"/>
        <SolidColorBrush x:Key="SurfaceHover" Color="#22304A"/>
        <SolidColorBrush x:Key="Border" Color="#2B3A55"/>
        <SolidColorBrush x:Key="Accent" Color="#5865F2"/>
        <SolidColorBrush x:Key="AccentHover" Color="#6875FF"/>
        <SolidColorBrush x:Key="Text" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="Muted" Color="#94A3B8"/>

        <Style x:Key="MazButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="{StaticResource Surface2}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHover}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.82"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource MazButton}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="#7882FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHover}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.82"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccountButton" TargetType="Button" BasedOn="{StaticResource MazButton}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="MazTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{StaticResource SurfaceHover}"/><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{StaticResource Accent}"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="#7C83FF"/><Setter Property="Foreground" Value="White"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Border Width="48" Height="48" Background="{StaticResource Accent}" CornerRadius="10" Margin="0,0,14,0">
                <TextBlock Text="M" Foreground="White" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="MazLauncher" Foreground="White" FontSize="30" FontWeight="Bold"/>
                <TextBlock Text="Versioned Vanilla + MazClient installations" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,4,0,0"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Margin="0,20,0,0" Padding="16,13">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="AccountText" Text="Not signed in" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="Microsoft/Xbox account • cached between launches" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="SignOutButton" Style="{StaticResource AccountButton}" Content="SIGN OUT" Width="104" Margin="0,0,8,0" Click="SignOutButton_Click" Visibility="Collapsed"/>
                    <Button x:Name="SignInButton" Style="{StaticResource AccentButton}" Content="SIGN IN" Width="116" Height="36" Padding="12,0" FontSize="12" Click="SignInButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="2" Margin="0,18,0,0" Background="Transparent" BorderThickness="0" Foreground="White">
            <TabControl.Resources><Style TargetType="TabItem" BasedOn="{StaticResource MazTabItem}"/></TabControl.Resources>
            <TabItem Header="PLAY">
                <Grid Background="{StaticResource Surface}" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="VanillaButton" Click="VanillaButton_Click" Style="{StaticResource MazButton}" Height="112" Padding="18">
                        <StackPanel><TextBlock Text="VANILLA" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock x:Name="VanillaSelectedText" Text="Loading versions..." Foreground="#CBD5E1" Margin="0,7,0,0" HorizontalAlignment="Center"/><TextBlock Text="Uses selection from Installations" Foreground="{StaticResource Muted}" Margin="0,3,0,0" HorizontalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button Grid.Column="2" x:Name="MazButton" Click="MazButton_Click" Style="{StaticResource AccentButton}" Height="112" Padding="18">
                        <StackPanel><TextBlock Text="MAZCLIENT" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock x:Name="MazVersionText" Text="Loading versions..." Foreground="White" Margin="0,7,0,0" HorizontalAlignment="Center"/><TextBlock Text="Version-isolated mods + configs" Foreground="#E2E8F0" Margin="0,3,0,0" HorizontalAlignment="Center"/></StackPanel>
                    </Button>
                </Grid>
            </TabItem>

            <TabItem Header="INSTALLATIONS">
                <Grid Background="{StaticResource Surface}" Margin="18,24,18,18">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Vanilla installation" Foreground="White" FontSize="17" FontWeight="SemiBold"/>
                    <Grid Grid.Row="1" Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="136"/></Grid.ColumnDefinitions><ComboBox x:Name="VanillaVersionBox" SelectionChanged="VanillaVersionBox_SelectionChanged"/><Button Grid.Column="2" Style="{StaticResource MazButton}" x:Name="LaunchVanillaSelectedButton" Content="LAUNCH" Click="LaunchVanillaSelectedButton_Click"/></Grid>
                    <TextBlock Grid.Row="3" Text="MazClient installation" Foreground="White" FontSize="17" FontWeight="SemiBold"/>
                    <Grid Grid.Row="4" Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="136"/></Grid.ColumnDefinitions><ComboBox x:Name="MazClientVersionBox" SelectionChanged="MazClientVersionBox_SelectionChanged"/><Button Grid.Column="2" Style="{StaticResource AccentButton}" x:Name="LaunchMazSelectedButton" Content="LAUNCH" Click="LaunchMazSelectedButton_Click"/></Grid>
                    <TextBlock Grid.Row="5" Margin="0,14,0,0" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Text="Vanilla versions are loaded from Minecraft's version catalog. MazClient versions come from versioned MazClient GitHub releases. Each MazClient version has its own game directory, mods, configs, and cache."/>
                </Grid>
            </TabItem>

            <TabItem Header="MODS">
                <Grid Background="{StaticResource Surface}" Margin="18,24,18,18">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="MazClient installation" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                    <ComboBox Grid.Row="1" x:Name="ModsMazVersionBox" Margin="0,8,0,10" SelectionChanged="ModsMazVersionBox_SelectionChanged"/>
                    <ListBox Grid.Row="2" x:Name="ModList"/>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource AccentButton}" Content="ADD JAR" Width="96" Margin="0,0,8,0" Click="AddModButton_Click"/>
                        <Button Style="{StaticResource MazButton}" Content="TOGGLE" Width="92" Margin="0,0,8,0" Click="ToggleModButton_Click"/>
                        <Button Style="{StaticResource MazButton}" Content="REMOVE" Width="92" Margin="0,0,8,0" Click="RemoveModButton_Click"/>
                        <Button Style="{StaticResource MazButton}" Content="OPEN FOLDER" Width="116" Click="OpenModsFolderButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="SKINS">
                <Grid Background="{StaticResource Surface}" Margin="18,24,18,18">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="500">
                        <TextBlock Text="SKINS" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Skin account controls are linked to your signed-in Microsoft Minecraft profile. In-launcher saved skin slots and previews are the next layer." Foreground="#CBD5E1" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,16"/>
                        <Button Style="{StaticResource AccentButton}" Content="OPEN SKIN MANAGER" Height="40" Width="190" Click="OpenSkinManagerButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <Button Grid.Row="3" x:Name="CheckUpdatesButton" Style="{StaticResource MazButton}" Content="CHECK FOR UPDATES" Width="164" HorizontalAlignment="Left" Margin="0,14,0,0" Click="CheckUpdatesButton_Click"/>
        <StackPanel Grid.Row="4" Margin="0,10,0,0"><ProgressBar x:Name="Progress" Height="6" Minimum="0" Maximum="100" Value="0"/><TextBlock x:Name="StatusText" Text="Ready" Foreground="#CBD5E1" FontSize="12" Margin="0,7,0,0"/></StackPanel>
    </Grid>
</Window>
