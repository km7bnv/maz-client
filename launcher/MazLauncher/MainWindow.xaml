<Window x:Class="MazLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MazLauncher" Height="650" Width="920" MinHeight="590" MinWidth="820"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Icon="Assets/MazLauncher.ico" Background="#0F172A">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Border Width="48" Height="48" Background="#5865F2" CornerRadius="9" Margin="0,0,14,0">
                <TextBlock Text="M" Foreground="White" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="MazLauncher" Foreground="White" FontSize="30" FontWeight="Bold"/>
                <TextBlock Text="Versioned Vanilla + MazClient installations" Foreground="#94A3B8" FontSize="14" Margin="0,6,0,0"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Background="#111827" CornerRadius="10" Margin="0,22,0,0" Padding="16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock x:Name="AccountText" Text="Not signed in" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="Microsoft/Xbox account • cached between launches" Foreground="#94A3B8" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="SignOutButton" Content="Sign out" Width="92" Height="34" Margin="0,0,8,0" Click="SignOutButton_Click" Visibility="Collapsed"/>
                    <Button x:Name="SignInButton" Content="Sign in with Microsoft" Width="170" Height="34" Click="SignInButton_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="2" Margin="0,20,0,0" Background="#111827" BorderBrush="#334155" Foreground="#0F172A">
            <TabItem Header="PLAY">
                <Grid Background="#111827" Margin="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="VanillaButton" Click="VanillaButton_Click" Padding="20" Background="#1E293B" BorderBrush="#334155">
                        <StackPanel><TextBlock Text="VANILLA" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock x:Name="VanillaSelectedText" Text="Loading versions..." Foreground="#CBD5E1" Margin="0,8,0,0" HorizontalAlignment="Center"/><TextBlock Text="Uses selection from Installations" Foreground="#94A3B8" Margin="0,4,0,0" HorizontalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button Grid.Column="2" x:Name="MazButton" Click="MazButton_Click" Padding="20" Background="#5865F2" BorderBrush="#7C83FF">
                        <StackPanel><TextBlock Text="MAZCLIENT" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock x:Name="MazVersionText" Text="Loading versions..." Foreground="White" Margin="0,8,0,0" HorizontalAlignment="Center"/><TextBlock Text="Version-isolated mods + configs" Foreground="#E2E8F0" Margin="0,4,0,0" HorizontalAlignment="Center"/></StackPanel>
                    </Button>
                </Grid>
            </TabItem>

            <TabItem Header="INSTALLATIONS">
                <Grid Background="#111827" Margin="18">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Vanilla installation" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <Grid Grid.Row="1" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><ComboBox x:Name="VanillaVersionBox" Height="34" SelectionChanged="VanillaVersionBox_SelectionChanged"/><Button Grid.Column="2" x:Name="LaunchVanillaSelectedButton" Content="LAUNCH VANILLA" Click="LaunchVanillaSelectedButton_Click"/></Grid>
                    <TextBlock Grid.Row="3" Text="MazClient installation" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <Grid Grid.Row="4" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><ComboBox x:Name="MazClientVersionBox" Height="34" SelectionChanged="MazClientVersionBox_SelectionChanged"/><Button Grid.Column="2" x:Name="LaunchMazSelectedButton" Content="LAUNCH MAZCLIENT" Click="LaunchMazSelectedButton_Click"/></Grid>
                    <TextBlock Grid.Row="5" Margin="0,16,0,0" TextWrapping="Wrap" Foreground="#94A3B8" Text="Vanilla versions are loaded from Minecraft's version catalog. MazClient versions come from versioned MazClient GitHub releases. Each MazClient version has its own game directory, mods, configs, and cache."/>
                </Grid>
            </TabItem>

            <TabItem Header="MODS">
                <Grid Background="#111827" Margin="18">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="MazClient installation" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                    <ComboBox Grid.Row="1" x:Name="ModsMazVersionBox" Height="34" Margin="0,8,0,10" SelectionChanged="ModsMazVersionBox_SelectionChanged"/>
                    <ListBox Grid.Row="2" x:Name="ModList" Background="#0F172A" Foreground="White" BorderBrush="#334155"/>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="ADD JAR" Width="100" Margin="0,0,8,0" Click="AddModButton_Click"/>
                        <Button Content="ENABLE / DISABLE" Width="140" Margin="0,0,8,0" Click="ToggleModButton_Click"/>
                        <Button Content="REMOVE" Width="90" Margin="0,0,8,0" Click="RemoveModButton_Click"/>
                        <Button Content="OPEN FOLDER" Width="110" Click="OpenModsFolderButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="SKINS">
                <Grid Background="#111827" Margin="18">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="520">
                        <TextBlock Text="SKINS" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Skin account controls are linked to your signed-in Microsoft Minecraft profile. In-launcher saved skin slots and previews are the next layer; this button opens the official skin manager without signing you out." Foreground="#CBD5E1" TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,18"/>
                        <Button Content="OPEN MINECRAFT SKIN MANAGER" Height="38" Width="250" Click="OpenSkinManagerButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <Button Grid.Row="3" x:Name="CheckUpdatesButton" Content="CHECK FOR UPDATES" Height="34" Margin="0,16,0,0" Click="CheckUpdatesButton_Click"/>
        <StackPanel Grid.Row="4" Margin="0,12,0,0"><ProgressBar x:Name="Progress" Height="8" Minimum="0" Maximum="100" Value="0"/><TextBlock x:Name="StatusText" Text="Ready" Foreground="#CBD5E1" FontSize="12" Margin="0,8,0,0"/></StackPanel>
    </Grid>
</Window>
